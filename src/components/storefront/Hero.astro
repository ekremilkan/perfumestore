---
import type { Translator } from '../../lib/i18n';

const { t, heroImage } = Astro.props as {
  t: Translator;
  heroImage?: {
    url: string | null;
    alt: string | null;
  } | null;
};

// Premium dark backdrop blended with optional hero image
const backgroundImage = heroImage?.url
  ? `background-image:
      radial-gradient(circle at 20% 10%, rgba(197,157,95,0.25), transparent 55%),
      radial-gradient(circle at 80% 20%, rgba(248,216,0,0.18), transparent 60%),
      radial-gradient(circle at 50% 50%, rgba(197,157,95,0.1), transparent 70%),
      linear-gradient(135deg, rgba(17,17,17,0.95), rgba(17,17,17,0.85)),
      url(${heroImage.url});`
  : `background-image:
      radial-gradient(circle at 20% 10%, rgba(197,157,95,0.25), transparent 55%),
      radial-gradient(circle at 80% 20%, rgba(248,216,0,0.18), transparent 60%),
      radial-gradient(circle at 50% 50%, rgba(197,157,95,0.1), transparent 70%),
      linear-gradient(135deg, #14100d, #1e1711);`;
---

<section
  id="hero"
  class="relative overflow-hidden text-white min-h-[100svh] md:min-h-screen flex items-center w-full"
>
  <!-- Background video -->
  <video
    class="absolute inset-0 w-full h-full object-cover z-0"
    autoplay
    muted
    loop
    playsinline
    aria-hidden="true"
  >
    <source src="/videos/hero-video.mp4" type="video/mp4" />
  </video>

  <!-- Texture layer for premium feel -->
  <div class="absolute inset-0 opacity-35 z-5" aria-hidden="true">
    <div class="h-full w-full bg-[radial-gradient(circle_at_30%_20%,rgba(255,255,255,0.08),transparent_55%)]"></div>
  </div>

  <!-- Dark overlay for text readability -->
  <div class="absolute inset-0 bg-black/40 z-2" aria-hidden="true"></div>

  <!-- Glow layer for premium effect -->
  <div class="absolute inset-0 opacity-20 z-1" aria-hidden="true">
    <div class="h-full w-full bg-[radial-gradient(circle_at_50%_50%,color-mix(in srgb,var(--color-primary) 20%,transparent 80%),transparent_60%)]"></div>
  </div>

  <!-- Texture layer for premium feel -->
  <div class="absolute inset-0 opacity-35 z-5" aria-hidden="true">
    <div class="h-full w-full bg-[radial-gradient(circle_at_30%_20%,rgba(255,255,255,0.08),transparent_55%)]"></div>
  </div>

  <!-- Centered hero content matching the reference -->
  <div class="relative z-10 mx-auto flex max-w-3xl flex-col items-center gap-6 px-6 py-20 text-center md:py-28">
    {heroImage?.url && (
      <img
        src={heroImage.url}
        alt={heroImage.alt ?? ''}
        class="mb-2 h-24 w-24 rounded-lg object-cover shadow-lg"
        loading="lazy"
      />
    )}

     <h1 class="font-heading text-4xl font-semibold text-white md:text-5xl" style="text-shadow: 0 0 20px color-mix(in srgb, var(--color-primary) 50%, transparent 50%);">
       {t('hero.heading')}
     </h1>
    <p class="max-w-xl text-base leading-relaxed text-[color-mix(in srgb,white 85%,transparent 15%)] md:text-lg">
      {t('hero.subheading')}
    </p>
     <a
      href="/#collection"
      class="inline-flex items-center justify-center rounded-full bg-[var(--color-primary)] px-6 py-3 text-sm font-semibold text-[var(--color-secondary)] shadow-lg transition hover:bg-[color-mix(in srgb,var(--color-primary) 90%,white 10%)] hover:shadow-xl"
      style="box-shadow: 0 0 20px color-mix(in srgb, var(--color-primary) 40%, transparent 60%), 0 4px 12px rgba(0,0,0,0.3);"
    >
      {t('hero.primaryCta')}
    </a>

    <!-- Scent Notes Preview -->
    <div class="mt-12 grid grid-cols-3 gap-6 text-center">
      <div class="space-y-2">
        <div class="mx-auto h-12 w-12 rounded-full bg-[color-mix(in srgb,var(--color-primary) 20%,transparent 80%)] flex items-center justify-center animate-soft-float" style="animation-delay: 0s;">
          <span class="text-xs font-semibold text-[var(--color-primary)]">T</span>
        </div>
        <h3 class="text-sm font-semibold text-white">{t('hero.stats.top')}</h3>
        <p class="text-xs text-[color-mix(in srgb,white 80%,transparent 20%)]">{t('hero.stats.topNotes')}</p>
      </div>
      <div class="space-y-2">
        <div class="mx-auto h-12 w-12 rounded-full bg-[color-mix(in srgb,var(--color-primary) 20%,transparent 80%)] flex items-center justify-center animate-soft-float" style="animation-delay: 1s;">
          <span class="text-xs font-semibold text-[var(--color-primary)]">H</span>
        </div>
        <h3 class="text-sm font-semibold text-white">{t('hero.stats.heart')}</h3>
        <p class="text-xs text-[color-mix(in srgb,white 80%,transparent 20%)]">{t('hero.stats.heartNotes')}</p>
      </div>
      <div class="space-y-2">
        <div class="mx-auto h-12 w-12 rounded-full bg-[color-mix(in srgb,var(--color-primary) 20%,transparent 80%)] flex items-center justify-center animate-soft-float" style="animation-delay: 2s;">
          <span class="text-xs font-semibold text-[var(--color-primary)]">B</span>
        </div>
        <h3 class="text-sm font-semibold text-white">{t('hero.stats.base')}</h3>
        <p class="text-xs text-[color-mix(in srgb,white 80%,transparent 20%)]">{t('hero.stats.baseNotes')}</p>
      </div>
    </div>
   </div>

  {heroImage?.alt && <span class="sr-only">{heroImage.alt}</span>}
</section>
