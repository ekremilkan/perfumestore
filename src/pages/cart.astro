---
import { CartTable } from '../components/storefront/CartTable.tsx';
import Layout from '../layouts/Layout.astro';
import { getCartContext } from '../lib/cart';
import { createTranslator } from '../lib/i18n';

const locale = Astro.locals.locale ?? 'en';
const t = createTranslator(locale);
const cart = await getCartContext(Astro.cookies);

const lines = cart.lines.map((line) => ({
  productId: line.product.id,
  name: line.product.name,
  image: line.product.image,
  price: Number(line.product.price ?? 0),
  quantity: line.quantity,
  subtotal: line.subtotal
}));
---

<Layout title={t('meta.cartTitle')} description={t('meta.cartDescription')}>
  <section class="space-y-8 py-12">
    <header class="space-y-2">
      <h1 class="font-heading text-3xl font-semibold text-[var(--color-secondary)]">
        {t('cart.title')}
      </h1>
      <p class="text-sm text-[color-mix(in srgb,var(--color-secondary) 70%,white 30%)]">
        {t('cart.shippingNotice')}
      </p>
    </header>
    <CartTable
      client:load
      initialLines={lines}
      locale={locale}
      currency="EUR"
      texts={{
        remove: t('cart.remove'),
        quantity: t('cart.quantity'),
        subtotal: t('cart.subtotal'),
        empty: t('cart.empty'),
        updateError: t('notifications.cartError'),
        checkout: t('cart.checkout'),
        continue: t('cart.continue'),
        itemLabel: t('cart.items')
      }}
    />
  </section>
</Layout>
